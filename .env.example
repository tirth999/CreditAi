# =============================================================================
# CreditAI — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# --- NextAuth (Frontend) ---
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# --- PostgreSQL (Neon or local) ---
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require
DATABASE_URL_SYNC=postgresql://user:password@host/dbname?sslmode=require

# --- JWT Auth ---
JWT_SECRET_KEY=your-jwt-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Upstash Redis (REST API — session cache, rate limiting) ---
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# --- Local Redis (TCP — Celery broker, dev only) ---
REDIS_URL=redis://localhost:6379

# --- ML Microservice ---
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_API_KEY=your-ml-api-key

# --- Kaggle API (optional — dataset downloads) ---
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- HuggingFace (optional — FinBERT NLP) ---
HF_TOKEN=

# --- MLflow (local tracking) ---
MLFLOW_TRACKING_URI=./mlruns
MODEL_ARTIFACT_DIR=./artifacts

# --- CORS ---
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8000","http://localhost:8001"]
